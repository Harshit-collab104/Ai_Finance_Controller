*.py[cod]
*$py.class
*.so
.python-version

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & API Keys
.env
.env.local
.env.*.local

# Python Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# SQLite Database & Local Data Caches (Regenerated via scripts/run_pipeline.py)
*.db
*.sqlite3
backend/financials.db
data/financials.db

# ==========================================
# Node.js & React Frontend Ignores
# ==========================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Node Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite Caches
.vite/
frontend/.vite/

# ==========================================
